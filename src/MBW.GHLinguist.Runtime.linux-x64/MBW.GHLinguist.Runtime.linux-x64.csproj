<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IncludeSymbols>false</IncludeSymbols>
    <PackageId>MBW.GHLinguist.Runtime.linux-x64</PackageId>
    <Title>MBW.GHLinguist.Runtime.linux-x64</Title>
    <Description>Linux x64 native runtime closure for MBW.GHLinguist.</Description>
    <PackageLicenseFile>PACKAGE-LICENSES.md</PackageLicenseFile>
    <PackageProjectUrl>https://github.com/LordMike/MBW.GHLinguist</PackageProjectUrl>
    <RepositoryUrl>https://github.com/LordMike/MBW.GHLinguist</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>github;linguist;language-detection;code-analysis;dotnet;native;linux-x64</PackageTags>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReleaseNotes>See the GitHub release for changes in this version.</PackageReleaseNotes>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RidNativeAssetRoot>$(MSBuildThisFileDirectory)..\..\.tmp\artifacts\native</RidNativeAssetRoot>
    <NoWarn>$(NoWarn);NU5100;NU5128</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
    <None Include="..\..\PACKAGE-LICENSES.md" Pack="true" PackagePath="\" />
    <None Include="..\..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" />
    <None Include="..\..\eng\linguist\third-party-redistribution.json"
          Pack="true"
          PackagePath="THIRD-PARTY-REDISTRIBUTION.json"
          Visible="false" />
    <None Include="..\..\eng\nuget\icon.png" Pack="true" PackagePath="\" />
    <None Include="..\..\buildTransitive\MBW.GHLinguist.Runtime.linux-x64.targets"
          Pack="true"
          PackagePath="buildTransitive\MBW.GHLinguist.Runtime.linux-x64.targets"
          Visible="false" />
    <None Include="$(RidNativeAssetRoot)\linux-x64\ghlinguist.so"
          Pack="true"
          PackagePath="runtimes/linux-x64/native/ghlinguist.so"
          Visible="false" />
    <None Include="$(RidNativeAssetRoot)\linux-x64\**\*"
          Pack="true"
          PackagePath="nativeassets/linux-x64/"
          Visible="false" />
  </ItemGroup>

  <Target Name="ValidateLinuxX64NativeAssetsForPack"
          BeforeTargets="GenerateNuspec"
          Condition="'$(ValidateRidAssets)' == 'true'">
    <Error Condition="!Exists('$(RidNativeAssetRoot)\linux-x64\ghlinguist.so')"
           Text="Missing linux-x64 native bridge at $(RidNativeAssetRoot)\linux-x64\ghlinguist.so." />
    <Error Condition="!Exists('$(RidNativeAssetRoot)\linux-x64\provenance.json')"
           Text="Missing linux-x64 native closure provenance at $(RidNativeAssetRoot)\linux-x64\provenance.json." />
  </Target>
</Project>
