<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>true</IsPackable>
    <PackageId>MBW.GHLinguist</PackageId>
    <Title>MBW.GHLinguist</Title>
    <Description>GitHub Linguist interop for .NET 10. Set RuntimeIdentifier to win-x64 or linux-x64; matching native assets are selected automatically.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/LordMike/MBW.GHLinguist</PackageProjectUrl>
    <RepositoryUrl>https://github.com/LordMike/MBW.GHLinguist</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>github;linguist;language-detection;code-analysis;dotnet;native</PackageTags>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReleaseNotes>See the GitHub release for changes in this version.</PackageReleaseNotes>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <NoWarn>$(NoWarn);NU5100</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MBW.GHLinguist.Tests" />
    <ProjectReference Include="..\MBW.GHLinguist.Runtime.win-x64\MBW.GHLinguist.Runtime.win-x64.csproj" />
    <ProjectReference Include="..\MBW.GHLinguist.Runtime.linux-x64\MBW.GHLinguist.Runtime.linux-x64.csproj" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
    <None Include="..\..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" />
    <None Include="..\..\eng\linguist\third-party-redistribution.json"
          Pack="true"
          PackagePath="THIRD-PARTY-REDISTRIBUTION.json"
          Visible="false" />
    <None Include="..\..\eng\nuget\icon.png" Pack="true" PackagePath="\" />
    <None Include="..\MBW.GHLinguist.Native\include\ghlinguist.h"
          Pack="true"
          PackagePath="native\include\ghlinguist.h"
          Visible="false" />
    <None Include="..\..\buildTransitive\MBW.GHLinguist.targets"
          Pack="true"
          PackagePath="buildTransitive\MBW.GHLinguist.targets"
           Visible="false" />
  </ItemGroup>

  <Target Name="UseExactRuntimePackageDependencies"
          AfterTargets="_GetProjectReferenceVersions"
          BeforeTargets="GenerateNuspec">
    <ItemGroup>
      <_ProjectReferencesWithVersions Update="@(_ProjectReferencesWithVersions)">
        <ProjectVersion>[$(PackageVersion)]</ProjectVersion>
      </_ProjectReferencesWithVersions>
    </ItemGroup>
  </Target>
</Project>
