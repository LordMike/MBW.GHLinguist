<Project>
  <Target Name="RequireMBWGHLinguistRuntimePackage"
          BeforeTargets="CopyFilesToOutputDirectory;CopyFilesToPublishDirectory"
          Condition="'$(MBWGHLinguistRuntimePackageInstalled)' != 'true'">
    <Error Text="Reference exactly one supported runtime package: MBW.GHLinguist.Runtime.win-x64 or MBW.GHLinguist.Runtime.linux-x64." />
  </Target>
</Project>
