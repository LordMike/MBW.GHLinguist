<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="$(MBWGHLinguistRuntimePackageId)" Version="$(MBWGHLinguistPackageVersion)" />
  </ItemGroup>

  <Target Name="ValidatePackageVersion" BeforeTargets="Restore">
    <Error Condition="'$(MBWGHLinguistPackageVersion)' == ''" Text="MBWGHLinguistPackageVersion must identify the package under test." />
    <Error Condition="'$(MBWGHLinguistRuntimePackageId)' == ''" Text="MBWGHLinguistRuntimePackageId must identify the runtime package under test." />
  </Target>
</Project>
