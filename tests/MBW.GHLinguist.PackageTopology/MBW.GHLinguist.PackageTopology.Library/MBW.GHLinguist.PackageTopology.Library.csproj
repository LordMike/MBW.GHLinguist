<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MBW.GHLinguist" Version="$(MBWGHLinguistPackageVersion)" />
  </ItemGroup>

  <Target Name="ValidatePackageVersion" BeforeTargets="Restore">
    <Error Condition="'$(MBWGHLinguistPackageVersion)' == ''" Text="MBWGHLinguistPackageVersion must identify the package under test." />
  </Target>
</Project>
