<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3.mtp-v2" Version="4.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\README.md" Link="README.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\buildTransitive\MBW.GHLinguist.targets" Link="MBW.GHLinguist.targets" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\buildTransitive\MBW.GHLinguist.Runtime.win-x64.targets" Link="MBW.GHLinguist.Runtime.win-x64.targets" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\buildTransitive\MBW.GHLinguist.Runtime.linux-x64.targets" Link="MBW.GHLinguist.Runtime.linux-x64.targets" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MBW.GHLinguist\MBW.GHLinguist.csproj" />
    <Using Include="Xunit" />
  </ItemGroup>

  <Target Name="CopyNativeIntegrationAssets" AfterTargets="Build" Condition="'$(RunNativeIntegrationTests)' == 'true'">
    <PropertyGroup>
      <NativeIntegrationAssetRoot>$(MSBuildThisFileDirectory)..\..\.tmp\artifacts\native\$(RuntimeIdentifier)</NativeIntegrationAssetRoot>
    </PropertyGroup>
    <Error Condition="'$(RuntimeIdentifier)' == ''" Text="RunNativeIntegrationTests requires a RuntimeIdentifier." />
    <Error Condition="!Exists('$(NativeIntegrationAssetRoot)')" Text="The staged native closure is missing: $(NativeIntegrationAssetRoot)" />
    <ItemGroup>
      <_NativeIntegrationAsset Include="$(NativeIntegrationAssetRoot)/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(_NativeIntegrationAsset)" DestinationFiles="@(_NativeIntegrationAsset->'$(OutDir)MBW.GHLinguist\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
