{
  "schemaVersion": 4,
  "purpose": "Authoritative component and license-output policy for each RID-local native closure. Resolved platform package identities are recorded in provenance.json.",
  "components": [
    {
      "component": "MBW.GHLinguist",
      "license": "MIT",
      "licenseSource": {
        "all": [
          "<repository>/LICENSE",
          "<repository>/THIRD-PARTY-NOTICES.md"
        ]
      },
      "output": "licenses/MBW.GHLinguist/",
      "requiredOutputs": {
        "linux-x64": [
          "licenses/MBW.GHLinguist/LICENSE",
          "licenses/MBW.GHLinguist/THIRD-PARTY-NOTICES.md"
        ],
        "win-x64": [
          "licenses/MBW.GHLinguist/LICENSE",
          "licenses/MBW.GHLinguist/THIRD-PARTY-NOTICES.md"
        ]
      }
    },
    {
      "component": "CRuby 4.0.6 and its standard library",
      "license": "Ruby License or 2-clause BSD; component-specific notices are in LEGAL",
      "licenseSource": {
        "linux-x64": [
          "<ruby-prefix>/COPYING",
          "<ruby-prefix>/share/doc/ruby/COPYING"
        ],
        "win-x64": [
          "<ruby-root>/COPYING",
          "<ruby-root>/LICENSE",
          "<ruby-root>/LICENSE.txt"
        ]
      },
      "output": "licenses/ruby/",
      "requiredFiles": [
        "COPYING",
        "BSDL",
        "LEGAL"
      ],
      "requiredOutputs": {
        "linux-x64": [
          "licenses/ruby/COPYING",
          "licenses/ruby/BSDL",
          "licenses/ruby/LEGAL"
        ],
        "win-x64": [
          "licenses/ruby/COPYING",
          "licenses/ruby/BSDL",
          "licenses/ruby/LEGAL"
        ]
      }
    },
    {
      "component": "RubyInstaller",
      "license": "RubyInstaller license; see installed distribution text",
      "licenseSource": {
        "win-x64": [
          "<ruby-root>/LICENSE",
          "<ruby-root>/LICENSE.txt",
          "<ruby-root>/RubyInstaller-LICENSE.txt"
        ]
      },
      "output": "licenses/rubyinstaller/LICENSE",
      "requiredOutputs": {
        "win-x64": [
          "licenses/rubyinstaller/LICENSE"
        ]
      }
    },
    {
      "component": "Psych 5.3.1 and libyaml 0.2.5",
      "license": "Expat",
      "licenseSource": {
        "all": [
          "<ruby-prefix>/LEGAL"
        ],
        "linux-x64": [
          "/usr/share/doc/libyaml-0-2/copyright"
        ]
      },
      "output": "licenses/ruby/LEGAL",
      "additionalOutput": "licenses/debian/libyaml-0-2/copyright on linux-x64",
      "requiredOutputs": {
        "linux-x64": [
          "licenses/ruby/LEGAL",
          "licenses/debian/libyaml-0-2/copyright"
        ],
        "win-x64": [
          "licenses/ruby/LEGAL"
        ]
      }
    },
    {
      "component": "GitHub Linguist 9.6.0",
      "license": "MIT",
      "licenseSource": {
        "all": [
          "<linguist-root>/LICENSE"
        ]
      },
      "output": "licenses/linguist/LICENSE",
      "requiredOutputs": {
        "linux-x64": [
          "licenses/linguist/LICENSE"
        ],
        "win-x64": [
          "licenses/linguist/LICENSE"
        ]
      }
    },
    {
      "component": "Configured gems: cgi 0.4.2, mini_mime 1.1.5, charlock_holmes 0.7.9, zlib 3.2.3, resolv 0.7.2",
      "license": "The license or copying files shipped in each installed gem",
      "licenseSource": {
        "all": [
          "<gem-root>/(LICENSE*|COPYING*)",
          "<repository>/eng/linguist/licenses/charlock_holmes-0.7.9-LICENSE"
        ]
      },
      "output": "licenses/gems/<name>-<version>/",
      "requiredOutputs": {
        "linux-x64": [
          "licenses/gems/cgi-0.4.2/COPYING",
          "licenses/gems/mini_mime-1.1.5/LICENSE.txt",
          "licenses/gems/charlock_holmes-0.7.9/charlock_holmes-0.7.9-LICENSE",
          "licenses/gems/zlib-3.2.3/COPYING",
          "licenses/gems/resolv-0.7.2/COPYING"
        ],
        "win-x64": [
          "licenses/gems/cgi-0.4.2/COPYING",
          "licenses/gems/mini_mime-1.1.5/LICENSE.txt",
          "licenses/gems/charlock_holmes-0.7.9/charlock_holmes-0.7.9-LICENSE",
          "licenses/gems/zlib-3.2.3/COPYING",
          "licenses/gems/resolv-0.7.2/COPYING"
        ]
      }
    },
    {
      "component": "Debian packages owning copied ELF libraries",
      "license": "Package-specific Debian copyright file",
