          "licenses/debian/libstdc++6/copyright",
          "licenses/debian/libyaml-0-2/copyright",
          "licenses/debian/zlib1g/copyright",
          "licenses/debian/common/GPL-2",
          "licenses/debian/common/GPL-3",
          "licenses/debian/common/LGPL-2",
          "licenses/debian/common/LGPL-2.1",
          "licenses/debian/common/LGPL-3"
        ]
      }
    },
    {
      "component": "ICU DLLs",
      "license": "Unicode-3.0",
      "licenseSource": {
